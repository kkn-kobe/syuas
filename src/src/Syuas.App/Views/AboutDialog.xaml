<Window x:Class="Syuas.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SYUASについて" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F7F8FA" Icon="/SYUAS;component/Assets/Syuas.ico"
        UseLayoutRounding="True" FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="28">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image x:Name="AppIcon" Source="/SYUAS;component/Assets/Syuas.png"
               Width="96" Height="96" Margin="0,0,24,0" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="SYUAS アプリアイコン" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="SYUAS" FontSize="30" FontWeight="SemiBold" Foreground="#172B4D" />
                    <TextBlock Text="Structure Your AsciiDoc Simply" FontSize="15" Foreground="#536579" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
      <TextBlock Text="© 2026 KUBOYAMA Kyota" TextWrapping="Wrap" Foreground="#334155" />
      <TextBlock Text="Technologies => .NET 8 / WPF / AvalonEdit / Asciidoctor.js / WebView2"
                 TextWrapping="Wrap" FontSize="12" Foreground="#536579" Margin="0,10,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
      <Button x:Name="CloseButton" Content="閉じる" MinWidth="88" Padding="16,6"
              HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnClose" />
    </Border>
  </Grid>
</Window>
