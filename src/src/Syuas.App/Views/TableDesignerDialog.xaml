<Window x:Class="Syuas.App.Views.TableDesignerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Dialog" Title="{Binding DialogTitle}" Width="1080" Height="790" MinWidth="800" MinHeight="590"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
  <Window.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static ApplicationCommands.Undo}" />
    <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static ApplicationCommands.Redo}" />
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Redo}" />
  </Window.InputBindings>
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,5" /><Setter Property="Margin" Value="3" /></Style>
    <Style x:Key="CellBorder" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CCD5E0" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter Property="Background" Value="#E9EFF7" /></DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="#2466BC" /><Setter Property="Background" Value="#E0EDFF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="16" Background="#F7F8FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <WrapPanel>
      <Label Content="行数" /><TextBox x:Name="RowsBox" Width="55" Margin="3" Padding="5" Text="{Binding RowsInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="表の行数" />
      <Label Content="列数" /><TextBox x:Name="ColumnsBox" Width="55" Margin="3" Padding="5" Text="{Binding ColumnsInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="表の列数" />
      <Button Content="サイズを適用" Command="{Binding ResizeCommand}" />
      <CheckBox Content="先頭行をヘッダーにする" IsChecked="{Binding HasHeader}" IsEnabled="{Binding CanModifyStructure}" VerticalAlignment="Center" Margin="12,0" />
      <TextBlock Text="行数はヘッダーを含む / 最大100行・50列" VerticalAlignment="Center" Foreground="#536579" />
    </WrapPanel>
    <DockPanel Grid.Row="1" Margin="0,5">
      <Label Content="表タイトル（任意）" /><TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Padding="5" AutomationProperties.Name="表タイトル" />
    </DockPanel>
    <Expander x:Name="WidthsExpander" Grid.Row="2" Header="列幅（比率・任意）" Margin="0,4,0,8">
      <StackPanel>
        <TextBlock Text="正の整数で比率を指定します。空欄は1として扱います。" Foreground="#536579" Margin="4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="WidthsList" ItemsSource="{Binding ColumnWidths}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="4">
              <TextBlock Text="{Binding Label}" />
              <TextBox Width="65" Padding="4" Loaded="WidthBoxLoaded" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}" />
            </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Expander>
    <StackPanel Grid.Row="3">
      <TextBlock x:Name="EditHint" Text="{Binding EditHint}" TextWrapping="Wrap" Foreground="#174A8B" Margin="3,0,3,8">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
      </TextBlock>
      <WrapPanel>
        <Button x:Name="UndoButton" Content="元に戻す" Command="{x:Static ApplicationCommands.Undo}" CommandTarget="{Binding ElementName=Dialog}" ToolTip="{Binding UndoToolTip}" />
        <Button x:Name="RedoButton" Content="やり直し" Command="{x:Static ApplicationCommands.Redo}" CommandTarget="{Binding ElementName=Dialog}" ToolTip="{Binding RedoToolTip}" />
        <Button Content="セル結合" Command="{Binding MergeCommand}" />
        <Button Content="結合解除" Command="{Binding UnmergeCommand}" />
        <Button Content="下に行追加" Command="{Binding AddRowCommand}" />
        <Button Content="行削除" Command="{Binding DeleteRowCommand}" ToolTip="選択範囲の先頭行を削除します" />
        <Button Content="右に列追加" Command="{Binding AddColumnCommand}" />
        <Button Content="列削除" Command="{Binding DeleteColumnCommand}" ToolTip="選択範囲の先頭列を削除します" />
        <TextBlock Text="{Binding SelectionLabel}" VerticalAlignment="Center" Margin="10,0" Foreground="#174A8B" />
      </WrapPanel>
      <TextBlock Text="クリックでセルを編集、Shift＋クリックで範囲選択。結合時の文章は順番にまとめ、解除後は左上セルに残します。"
                 TextWrapping="Wrap" Foreground="#536579" Margin="3,5,3,3" />
      <TextBlock Text="行・列削除は選択範囲の先頭行・列が対象です。削除やサイズ縮小は対象セルの内容も削除します。"
                 TextWrapping="Wrap" Foreground="#536579" Margin="3,0,3,8" />
      <TextBlock Text="{Binding InputStatus}" Foreground="#174A8B" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="2*" MinWidth="240" /></Grid.ColumnDefinitions>
      <Border BorderBrush="#CCD5E0" BorderThickness="1" Background="White">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="CellGrid" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#DDE4ED" />
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="生成するAsciiDoc" FontWeight="Bold" Margin="4,0,0,7" />
        <TextBox x:Name="PreviewBox" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, Yu Gothic UI" FontSize="13"
                 Padding="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#EDF2F8" AutomationProperties.Name="表のAsciiDocプレビュー" />
      </DockPanel>
    </Grid>
    <DockPanel Grid.Row="5" Margin="0,10,0,0">
      <Button x:Name="HelpButton" DockPanel.Dock="Left" Content="使い方" Click="OnHelp" IsEnabled="{Binding CanCancel}" ToolTip="表の作成・再編集と元に戻す操作の説明" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CancelButton" Content="キャンセル" IsCancel="{Binding CanCancel}" IsEnabled="{Binding CanCancel}" />
        <Button x:Name="ConfirmButton" Content="{Binding ConfirmLabel}" IsDefault="True" Command="{Binding ConfirmCommand}" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Text="{Binding Error}" Foreground="#A42A21" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</Window>
