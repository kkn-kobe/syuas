<Window x:Class="Syuas.App.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="復元可能な文書 — SYUAS" Width="830" Height="510" MinWidth="650" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA"
        FocusManager.FocusedElement="{Binding ElementName=LaterButton}">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="保存されていない文書の復元用コピーがあります。" FontSize="17" FontWeight="SemiBold" />
      <TextBlock Text="1件ずつ復元できます。「後で」を選んでも、ここにあるデータは保持されます。" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBox Text="{Binding Selected.FilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0" Padding="6" AutomationProperties.Name="元ファイルの場所" />
      <TextBlock Text="{Binding Selected.Detail}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="DiscardButton" Content="破棄する…" IsEnabled="{Binding CanDiscard}" Click="OnDiscard" Padding="14,7" Margin="0,0,8,0" />
        <Button x:Name="RestoreButton" Content="復元する" IsEnabled="{Binding CanRestore}" Click="OnRestore" Padding="14,7" Margin="0,0,8,0" />
        <Button x:Name="LaterButton" Content="後で" IsCancel="True" IsDefault="True" Padding="14,7" />
      </StackPanel>
    </StackPanel>
    <ListView x:Name="RecoveryList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Single">
      <ListView.View><GridView>
        <GridViewColumn Header="文書" Width="205" DisplayMemberBinding="{Binding Name}" />
        <GridViewColumn Header="退避日時" Width="155" DisplayMemberBinding="{Binding SavedAt}" />
        <GridViewColumn Header="元ファイルの状態" Width="285" DisplayMemberBinding="{Binding State}" />
      </GridView></ListView.View>
    </ListView>
  </DockPanel>
</Window>
