<Window x:Class="Syuas.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Syuas.Core.Models;assembly=Syuas.Core"
        Title="設定" Width="590" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F9FC">
  <StackPanel Margin="24">
    <TextBlock Text="データの保存" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
    <CheckBox Content="復元用コピーを自動作成する" IsChecked="{Binding RecoveryEnabled}" />
    <TextBlock Text="オフの場合、異常終了時に未保存の編集内容を復元できません。&#10;作成済みの復元用コピーは自動では削除しません。"
               TextWrapping="Wrap" Foreground="#536579" Margin="22,8,0,20" />
    <TextBlock Text="HTMLプレビューのディスクデータ" Margin="0,0,0,8" />
    <ComboBox SelectedValue="{Binding PreviewData}" SelectedValuePath="Tag" Padding="8">
      <ComboBoxItem Content="保持する" Tag="{x:Static models:PreviewDataMode.Keep}" />
      <ComboBoxItem Content="終了時に削除する" Tag="{x:Static models:PreviewDataMode.DeleteOnExit}" />
      <ComboBoxItem Content="作成しない（HTMLプレビュー無効）" Tag="{x:Static models:PreviewDataMode.Disabled}" />
    </ComboBox>
    <TextBlock Text="「終了時に削除する」は使用中のディスク保存を許可します。正常終了時に今回分を削除し、異常終了で残った分は次回起動時に削除を再試行します。"
               TextWrapping="Wrap" Foreground="#536579" Margin="0,10,0,12" />
    <TextBlock Text="変更は開いている文書にも適用されます。他の起動中のSYUASにも順次反映されます。以前の「保持する」で保存されたプレビューデータ、ファイル履歴、文書と同じフォルダーのバックアップは削除しません。"
               TextWrapping="Wrap" Foreground="#536579" Margin="0,0,0,20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" MinWidth="100" Padding="10,6" Margin="0,0,8,0" />
      <Button Content="OK" IsDefault="True" Click="OnAccept" MinWidth="90" Padding="10,6" />
    </StackPanel>
  </StackPanel>
</Window>
