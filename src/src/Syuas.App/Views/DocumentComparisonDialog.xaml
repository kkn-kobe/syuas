<Window x:Class="Syuas.App.Views.DocumentComparisonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="外部ファイルとの比較 — SYUAS" Width="1100" Height="720" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="6" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="{Binding CapturedAt, StringFormat='取得時刻: {0:yyyy/MM/dd HH:mm:ss}'}" Margin="0,4,0,0" />
      <TextBlock Text="取得時点の内容です。比較画面を閉じて再度開くと最新の内容を取得します。" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#536579" />
    </StackPanel>
    <Button DockPanel.Dock="Bottom" Content="閉じる" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Padding="18,7" Margin="0,12,0,0" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="編集中の内容" FontWeight="SemiBold" Margin="0,0,0,8" />
        <avalon:TextEditor x:Name="LocalEditor" IsReadOnly="True" ShowLineNumbers="True" FontFamily="Consolas, Yu Gothic UI" FontSize="14" Padding="8"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="編集中の内容（読み取り専用）" />
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDE4ED" />
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="ディスク上の内容" FontWeight="SemiBold" Margin="8,0,0,8" />
        <avalon:TextEditor x:Name="DiskEditor" IsReadOnly="True" ShowLineNumbers="True" FontFamily="Consolas, Yu Gothic UI" FontSize="14" Padding="8"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="ディスク上の内容（読み取り専用）" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
