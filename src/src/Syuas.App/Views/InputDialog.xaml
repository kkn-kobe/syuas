<Window x:Class="Syuas.App.Views.InputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="640" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <DataTemplate x:Key="FieldTemplate">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Margin="0,0,0,4" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="参照…" Padding="12,4" Margin="6,0,0,0"
                  Visibility="{Binding IsFile, Converter={StaticResource Visible}}" Command="{Binding BrowseCommand}" />
          <Grid>
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                     AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsText, Converter={StaticResource Visible}}"
                     AcceptsReturn="{Binding Multiline}" AcceptsTab="{Binding Multiline}" VerticalScrollBarVisibility="Auto">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Setter Property="MinHeight" Value="28" />
                  <Style.Triggers><DataTrigger Binding="{Binding Multiline}" Value="True">
                    <Setter Property="Height" Value="160" /><Setter Property="FontFamily" Value="Consolas, Yu Gothic UI" />
                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                  </DataTrigger></Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <ComboBox ItemsSource="{Binding Choices}" IsEditable="{Binding EditableChoice}"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"
                      AutomationProperties.Name="{Binding Label}" Visibility="{Binding HasChoices, Converter={StaticResource Visible}}" />
          </Grid>
        </DockPanel>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel Margin="20" Background="#F7F8FA">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding Error}" Foreground="#A42A21" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" IsCancel="True" Padding="16,6" Margin="4" />
        <Button Content="挿入" IsDefault="True" Command="{Binding InsertCommand}" Padding="20,6" Margin="4" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#536579" Margin="0,0,0,16" />
        <StackPanel Visibility="{Binding ShowReferences, Converter={StaticResource Visible}}" Margin="0,0,0,12">
          <TextBlock Text="現在の文書の見出し・アンカー（簡易解析）" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding ReferenceCandidates}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedReference}" Padding="6,4"
                    AutomationProperties.Name="文書内の参照先候補" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding BasicFields}" ItemTemplate="{StaticResource FieldTemplate}" />
        <Expander Header="詳細設定" Visibility="{Binding HasAdvanced, Converter={StaticResource Visible}}" Margin="0,0,0,10">
          <ItemsControl ItemsSource="{Binding AdvancedFields}" ItemTemplate="{StaticResource FieldTemplate}" Margin="8" />
        </Expander>
        <TextBlock Text="生成するAsciiDoc" FontWeight="Bold" Margin="0,10,0,6" />
        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="140"
                 FontFamily="Consolas, Yu Gothic UI" Padding="8" Background="#EDF2F8"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="生成するAsciiDoc" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
