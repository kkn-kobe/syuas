<Window x:Class="Syuas.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{Binding Title}" Width="1120" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        Closing="OnClosing" Closed="OnClosed" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,5" /><Setter Property="Margin" Value="3" /></Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Padding="6,3" Background="White">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規作成(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="最近使用したファイル(_R)" ItemsSource="{Binding RecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding}" />
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
              <Setter Property="ToolTip" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="終了(_X)" Click="OnExit" InputGestureText="Alt+F4" />
      </MenuItem>
      <MenuItem Header="編集(_E)">
        <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="やり直し(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="切り取り(_T)" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=Editor}" />
        <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=Editor}" />
        <MenuItem Header="貼り付け(_P)" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=Editor}" />
        <MenuItem Header="すべて選択(_A)" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=Editor}" />
        <Separator />
        <MenuItem Header="検索(_F)..." Click="OnFind" InputGestureText="Ctrl+F" />
        <MenuItem Header="置換(_H)..." Click="OnReplace" InputGestureText="Ctrl+H" />
        <MenuItem Header="次を検索(_N)" Command="{Binding FindNextCommand}" InputGestureText="F3" />
      </MenuItem>
      <MenuItem Header="挿入(_I)">
        <MenuItem Header="見出し…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Heading" />
        <MenuItem Header="表…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Table" />
        <MenuItem Header="画像…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Image" />
        <MenuItem Header="外部ファイル参照 (include)…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Include" />
        <MenuItem Header="リンク…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Link" />
        <MenuItem Header="相互参照 (xref)…" Command="{Binding Assistance.InsertCommand}" CommandParameter="CrossReference" />
        <MenuItem Header="アンカー / ID…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Anchor" />
        <Separator />
        <MenuItem Header="ソースブロック…" Command="{Binding Assistance.InsertCommand}" CommandParameter="SourceBlock" />
        <MenuItem Header="Admonition…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Admonition" />
        <MenuItem Header="リスト">
          <MenuItem Header="箇条書き" Command="{Binding Assistance.InsertCommand}" CommandParameter="UnorderedList" />
          <MenuItem Header="番号付きリスト" Command="{Binding Assistance.InsertCommand}" CommandParameter="OrderedList" />
          <MenuItem Header="チェックリスト" Command="{Binding Assistance.InsertCommand}" CommandParameter="Checklist" />
        </MenuItem>
        <MenuItem Header="ブロック">
          <MenuItem Header="Listing Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="ListingBlock" />
          <MenuItem Header="Literal Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="LiteralBlock" />
          <MenuItem Header="Quote Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="QuoteBlock" />
          <MenuItem Header="Example Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="ExampleBlock" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="書式(_O)">
        <MenuItem Header="太字 (Bold)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Bold" />
        <MenuItem Header="斜体 (Italic)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Italic" />
        <MenuItem Header="等幅 (Monospace)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Monospace" />
      </MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem Header="行番号" IsCheckable="True" IsChecked="{Binding ShowLineNumbers, ElementName=Editor}" />
        <MenuItem Header="右端で折り返す" IsCheckable="True" IsChecked="{Binding WordWrap, ElementName=Editor}" />
      </MenuItem>
      <MenuItem Header="ヘルプ(_H)"><MenuItem Header="SYUASについて" Click="OnAbout" /></MenuItem>
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" Background="#EEF1F5">
      <ToolBar Background="#EEF1F5">
        <Button Content="新規" Command="{Binding NewCommand}" ToolTip="新規作成 (Ctrl+N)" />
        <Button Content="開く" Command="{Binding OpenCommand}" ToolTip="開く (Ctrl+O)" />
        <Button Content="保存" Command="{Binding SaveCommand}" ToolTip="保存 (Ctrl+S)" />
        <Separator />
        <Button Content="元に戻す" Command="{Binding UndoCommand}" />
        <Button Content="やり直し" Command="{Binding RedoCommand}" />
        <Separator />
        <Button Content="検索 / 置換" Click="OnFind" />
        <Separator />
        <Button Content="見出し" Command="{Binding Assistance.InsertCommand}" CommandParameter="Heading" />
        <Button Content="表" Command="{Binding Assistance.InsertCommand}" CommandParameter="Table" />
        <Button Content="画像" Command="{Binding Assistance.InsertCommand}" CommandParameter="Image" />
        <Button Content="Include" Command="{Binding Assistance.InsertCommand}" CommandParameter="Include" />
        <Button Content="リンク" Command="{Binding Assistance.InsertCommand}" CommandParameter="Link" />
        <Button Content="コード" Command="{Binding Assistance.InsertCommand}" CommandParameter="SourceBlock" />
        <Separator />
        <Button Content="B" FontWeight="Bold" ToolTip="太字" Command="{Binding Assistance.InsertCommand}" CommandParameter="Bold" />
        <Button Content="I" FontStyle="Italic" ToolTip="斜体" Command="{Binding Assistance.InsertCommand}" CommandParameter="Italic" />
        <Button Content="等幅" ToolTip="Monospace" Command="{Binding Assistance.InsertCommand}" CommandParameter="Monospace" />
      </ToolBar>
    </ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom" Background="#E9EEF5" Padding="8,4">
      <StatusBarItem Content="{Binding Position}" MinWidth="130" />
      <Separator />
      <StatusBarItem Content="{Binding DocumentStatus}" MinWidth="110" />
      <Separator />
      <StatusBarItem Content="UTF-8  |  AsciiDoc" />
    </StatusBar>
    <Border DockPanel.Dock="Top" Padding="10,7" Background="#EEF3F9" Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <Label Content="検索" Target="{Binding ElementName=SearchBox}" Width="50" />
          <TextBox x:Name="SearchBox" Width="250" Margin="3" Padding="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
          <Button Content="次を検索" Command="{Binding FindNextCommand}" />
          <CheckBox Content="大文字と小文字を区別" IsChecked="{Binding MatchCase}" VerticalAlignment="Center" Margin="10,0" />
          <Button Content="閉じる" Click="OnCloseSearch" />
        </WrapPanel>
        <WrapPanel>
          <Label Content="置換" Target="{Binding ElementName=ReplacementBox}" Width="50" />
          <TextBox x:Name="ReplacementBox" Width="250" Margin="3" Padding="5" Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="置換" Command="{Binding ReplaceCommand}" />
          <Button Content="すべて置換" Command="{Binding ReplaceAllCommand}" />
          <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="10,0" AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <avalon:TextEditor x:Name="Editor" ShowLineNumbers="True" FontFamily="Consolas, Yu Gothic UI" FontSize="15"
                       Padding="12" Background="White" Foreground="#202B3C" LineNumbersForeground="#8A96A6"
                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="AsciiDoc ソースエディタ">
      <avalon:TextEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Command="ApplicationCommands.Undo" />
          <MenuItem Command="ApplicationCommands.Redo" />
          <Separator />
          <MenuItem Command="ApplicationCommands.Cut" />
          <MenuItem Command="ApplicationCommands.Copy" />
          <MenuItem Command="ApplicationCommands.Paste" />
          <MenuItem Command="ApplicationCommands.SelectAll" />
        </ContextMenu>
      </avalon:TextEditor.ContextMenu>
    </avalon:TextEditor>
  </DockPanel>
</Window>
