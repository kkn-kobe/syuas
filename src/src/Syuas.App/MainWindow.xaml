<Window x:Class="Syuas.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:views="clr-namespace:Syuas.App.Views"
        Title="{Binding Title}" Width="1120" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA" Icon="/SYUAS;component/Assets/Syuas.ico"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        Closing="OnClosing" Closed="OnClosed" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
  <Window.InputBindings>
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseDocumentCommand}" />
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,5" /><Setter Property="Margin" Value="3" /></Style>
  </Window.Resources>
  <DockPanel>
    <DockPanel.Style>
      <Style TargetType="DockPanel">
        <Style.Triggers><DataTrigger Binding="{Binding IsRecoveryBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
      </Style>
    </DockPanel.Style>
    <Menu DockPanel.Dock="Top" Padding="6,3" Background="White">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規作成(_N)" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="開く(_O)..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="保存(_S)" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="名前を付けて保存(_A)..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <MenuItem Header="すべて保存" Command="{Binding SaveAllCommand}" />
        <MenuItem Header="タブを閉じる" Command="{Binding CloseDocumentCommand}" InputGestureText="Ctrl+W" />
        <Separator />
        <MenuItem Header="復元可能な文書…" Click="OnRecoveryDocuments" IsEnabled="{Binding HasRecovery}" />
        <MenuItem Header="外部変更を確認" Click="OnCheckExternal" />
        <MenuItem Header="ディスクから再読み込み" Click="OnReloadExternal" ToolTip="未保存の変更を確認して再読み込みします。Undo履歴はリセットされます。" />
        <MenuItem Header="ディスク上の内容と比較…" Click="OnCompareExternal" />
        <Separator />
        <MenuItem Header="最近使用したファイル(_R)" ItemsSource="{Binding RecentFiles}">
          <MenuItem.ItemContainerStyle>
            <Style TargetType="MenuItem">
              <Setter Property="Header" Value="{Binding}" />
              <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
              <Setter Property="CommandParameter" Value="{Binding}" />
              <Setter Property="ToolTip" Value="{Binding}" />
            </Style>
          </MenuItem.ItemContainerStyle>
        </MenuItem>
        <Separator />
        <MenuItem Header="終了(_X)" Click="OnExit" InputGestureText="Alt+F4" />
      </MenuItem>
      <MenuItem Header="編集(_E)">
        <MenuItem Header="元に戻す(_U)" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="やり直し(_R)" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem x:Name="EditTableMenu" Header="表を再編集…" Command="{Binding EditTableCommand}" ToolTip="表の中にカーソルを置くか、1つの表の中を選択してください。" />
        <Separator />
        <MenuItem Header="切り取り(_T)" Command="ApplicationCommands.Cut" CommandTarget="{Binding ActiveEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
        <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy" CommandTarget="{Binding ActiveEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
        <MenuItem Header="貼り付け(_P)" Command="ApplicationCommands.Paste" CommandTarget="{Binding ActiveEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
        <MenuItem Header="すべて選択(_A)" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ActiveEditor, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Separator />
        <MenuItem Header="検索(_F)..." Click="OnFind" InputGestureText="Ctrl+F" />
        <MenuItem Header="置換(_H)..." Click="OnReplace" InputGestureText="Ctrl+H" />
        <MenuItem Header="次を検索(_N)" Command="{Binding FindNextCommand}" InputGestureText="F3" />
      </MenuItem>
      <MenuItem Header="挿入(_I)">
        <MenuItem Header="見出し…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Heading" />
        <MenuItem Header="表…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Table" />
        <MenuItem Header="画像…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Image" />
        <MenuItem Header="外部ファイル参照 (include)…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Include" />
        <MenuItem Header="リンク…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Link" />
        <MenuItem Header="相互参照 (xref)…" Command="{Binding Assistance.InsertCommand}" CommandParameter="CrossReference" />
        <MenuItem Header="アンカー / ID…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Anchor" />
        <Separator />
        <MenuItem Header="ソースブロック…" Command="{Binding Assistance.InsertCommand}" CommandParameter="SourceBlock" />
        <MenuItem Header="Admonition…" Command="{Binding Assistance.InsertCommand}" CommandParameter="Admonition" />
        <MenuItem Header="リスト">
          <MenuItem Header="箇条書き" Command="{Binding Assistance.InsertCommand}" CommandParameter="UnorderedList" />
          <MenuItem Header="番号付きリスト" Command="{Binding Assistance.InsertCommand}" CommandParameter="OrderedList" />
          <MenuItem Header="チェックリスト" Command="{Binding Assistance.InsertCommand}" CommandParameter="Checklist" />
        </MenuItem>
        <MenuItem Header="ブロック">
          <MenuItem Header="Listing Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="ListingBlock" />
          <MenuItem Header="Literal Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="LiteralBlock" />
          <MenuItem Header="Quote Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="QuoteBlock" />
          <MenuItem Header="Example Block" Command="{Binding Assistance.InsertCommand}" CommandParameter="ExampleBlock" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="書式(_O)">
        <MenuItem Header="太字 (Bold)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Bold" />
        <MenuItem Header="斜体 (Italic)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Italic" />
        <MenuItem Header="等幅 (Monospace)" Command="{Binding Assistance.InsertCommand}" CommandParameter="Monospace" />
      </MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem Header="文書構造" IsCheckable="True" IsChecked="{Binding Structure.IsVisible}" />
        <MenuItem Header="HTMLプレビュー" IsCheckable="True" IsChecked="{Binding IsPreviewVisible}" IsEnabled="{Binding PreviewAllowed}" />
        <MenuItem Header="プレビューを更新" Click="OnRefreshPreview" IsEnabled="{Binding PreviewAllowed}" />
        <Separator />
        <MenuItem Header="行番号" IsCheckable="True" IsChecked="{Binding ActiveEditor.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=Window}}" />
        <MenuItem Header="右端で折り返す" IsCheckable="True" IsChecked="{Binding ActiveEditor.WordWrap, RelativeSource={RelativeSource AncestorType=Window}}" />
      </MenuItem>
      <MenuItem Header="ツール(_T)">
        <MenuItem Header="設定…" Click="OnSettings" />
      </MenuItem>
      <MenuItem Header="ヘルプ(_H)">
        <MenuItem Header="表の再編集の使い方" Click="OnTableEditingHelp" />
        <MenuItem Header="自動復元と外部変更の使い方" Click="OnRecoveryHelp" />
        <Separator />
        <MenuItem Header="SYUASについて" Click="OnAbout" />
      </MenuItem>
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" Background="#EEF1F5">
      <ToolBar Background="#EEF1F5">
        <Button Content="新規" Command="{Binding NewCommand}" ToolTip="新規作成 (Ctrl+N)" />
        <Button Content="開く" Command="{Binding OpenCommand}" ToolTip="開く (Ctrl+O)" />
        <Button Content="保存" Command="{Binding SaveCommand}" ToolTip="保存 (Ctrl+S)" />
        <Separator />
        <Button Content="元に戻す" Command="{Binding UndoCommand}" />
        <Button Content="やり直し" Command="{Binding RedoCommand}" />
        <Separator />
        <Button Content="検索 / 置換" Click="OnFind" />
        <Separator />
        <Button Content="見出し" Command="{Binding Assistance.InsertCommand}" CommandParameter="Heading" />
        <Button Content="表" Command="{Binding Assistance.InsertCommand}" CommandParameter="Table" />
        <Button Content="画像" Command="{Binding Assistance.InsertCommand}" CommandParameter="Image" />
        <Button Content="Include" Command="{Binding Assistance.InsertCommand}" CommandParameter="Include" />
        <Button Content="リンク" Command="{Binding Assistance.InsertCommand}" CommandParameter="Link" />
        <Button Content="コード" Command="{Binding Assistance.InsertCommand}" CommandParameter="SourceBlock" />
        <Separator />
        <Button Content="B" FontWeight="Bold" ToolTip="太字" Command="{Binding Assistance.InsertCommand}" CommandParameter="Bold" />
        <Button Content="I" FontStyle="Italic" ToolTip="斜体" Command="{Binding Assistance.InsertCommand}" CommandParameter="Italic" />
        <Button Content="等幅" ToolTip="Monospace" Command="{Binding Assistance.InsertCommand}" CommandParameter="Monospace" />
        <Separator />
        <ToggleButton Content="HTMLプレビュー" IsChecked="{Binding IsPreviewVisible}" IsEnabled="{Binding PreviewAllowed}" Padding="8,4" />
      </ToolBar>
    </ToolBarTray>
    <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" ItemsSource="{Binding Documents}"
                SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                Background="#EEF1F5" BorderThickness="0" Padding="0" AutomationProperties.Name="文書タブ">
      <TabControl.Style>
        <Style TargetType="TabControl">
          <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
        </Style>
      </TabControl.Style>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid Background="Transparent" ClipToBounds="True">
            <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" />
            </ScrollViewer>
            <Canvas IsHitTestVisible="False">
              <Border x:Name="DropIndicator" Width="3" Background="#2463A6" Visibility="Collapsed" />
            </Canvas>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
            <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" MaxWidth="230" TextTrimming="CharacterEllipsis" Margin="6,0" />
            <Button Content="×" Padding="5,0" Margin="3" Focusable="False" ToolTip="閉じる (Ctrl+W)"
                    AutomationProperties.Name="文書を閉じる"
                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
    <StatusBar DockPanel.Dock="Bottom" Background="#E9EEF5" Padding="8,4">
      <StatusBarItem Content="{Binding Position}" MinWidth="130" />
      <Separator />
      <StatusBarItem Content="{Binding DocumentStatus}" MinWidth="110" />
      <Separator />
      <StatusBarItem Content="UTF-8  |  AsciiDoc" />
      <Separator />
      <StatusBarItem><TextBlock Text="{Binding RecoveryStatus}" ToolTip="{Binding RecoveryStatus}" MaxWidth="420" TextTrimming="CharacterEllipsis" /></StatusBarItem>
      <StatusBarItem><TextBlock Text="{Binding MonitoringStatus}" ToolTip="{Binding MonitoringStatus}" MaxWidth="220" TextTrimming="CharacterEllipsis" /></StatusBarItem>
      <StatusBarItem Visibility="{Binding HasExternalChange, Converter={StaticResource BooleanToVisibility}}">
        <Button Content="{Binding ExternalChangeStatus}" Command="{Binding RevealExternalChangeCommand}" ToolTip="{Binding ExternalChangeMessage}" />
      </StatusBarItem>
    </StatusBar>
    <Border x:Name="ExternalChangeBanner" DockPanel.Dock="Top" Padding="12,9" Background="#FFF3CD"
            Visibility="{Binding IsExternalChangeVisible, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding ExternalChangeMessage}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ExternalChangeDetail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExternalChangeDetail}" Margin="0,4,0,4" />
        <WrapPanel>
          <Button Content="内容を比較…" Click="OnCompareExternal" IsEnabled="{Binding CanReadExternalFile}" />
          <Button Content="再読み込み" Click="OnReloadExternal" IsEnabled="{Binding CanReadExternalFile}" ToolTip="未保存の変更を確認して再読み込みします。Undo履歴はリセットされます。" />
          <Button Content="別名保存…" Command="{Binding SaveAsCommand}" />
          <Button Content="再確認" Click="OnCheckExternal" />
          <Button Content="編集を続ける" Command="{Binding DismissExternalChangeCommand}" ToolTip="通知を閉じます。保存時の外部変更チェックは継続します。" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="10,7" Background="#EEF3F9" Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <Label Content="検索" Target="{Binding ElementName=SearchBox}" Width="50" />
          <TextBox x:Name="SearchBox" Width="250" Margin="3" Padding="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown" />
          <Button Content="次を検索" Command="{Binding FindNextCommand}" />
          <CheckBox Content="大文字と小文字を区別" IsChecked="{Binding MatchCase}" VerticalAlignment="Center" Margin="10,0" />
          <Button Content="閉じる" Click="OnCloseSearch" />
        </WrapPanel>
        <WrapPanel>
          <Label Content="置換" Target="{Binding ElementName=ReplacementBox}" Width="50" />
          <TextBox x:Name="ReplacementBox" Width="250" Margin="3" Padding="5" Text="{Binding ReplacementText, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="置換" Command="{Binding ReplaceCommand}" />
          <Button Content="すべて置換" Command="{Binding ReplaceAllCommand}" />
          <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="10,0" AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid x:Name="DocumentLayout">
      <Grid.ColumnDefinitions>
        <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="210" />
          <Style.Triggers><DataTrigger Binding="{Binding Structure.IsVisible}" Value="False"><Setter Property="Width" Value="0" /><Setter Property="MaxWidth" Value="0" /></DataTrigger></Style.Triggers>
        </Style></ColumnDefinition.Style></ColumnDefinition>
        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" />
        <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*" />
          <Style.Triggers><DataTrigger Binding="{Binding IsPreviewVisible}" Value="False"><Setter Property="Width" Value="0" /><Setter Property="MaxWidth" Value="0" /></DataTrigger></Style.Triggers>
        </Style></ColumnDefinition.Style></ColumnDefinition>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Visibility="{Binding Structure.IsVisible, Converter={StaticResource BooleanToVisibility}}" Background="#F7F8FA">
        <TextBlock DockPanel.Dock="Top" Text="Document Outline" FontWeight="Bold" Margin="10" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Structure.Summary}" Foreground="#536579" Margin="10" />
        <TreeView x:Name="OutlineTree" ItemsSource="{Binding Structure.Roots}" SelectedItemChanged="OnOutlineSelected" BorderThickness="0" Background="Transparent">
          <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style></TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Title}" ToolTip="{Binding Location}" />
          </HierarchicalDataTemplate></TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#DDE4ED" Visibility="{Binding Structure.IsVisible, Converter={StaticResource BooleanToVisibility}}" />
    <Grid Grid.Column="2" x:Name="EditorHost" />
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="#DDE4ED" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibility}}" />
      <Border x:Name="PreviewHost" Grid.Column="4" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>
  </DockPanel>
</Window>

